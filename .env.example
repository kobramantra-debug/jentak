# Zkopiruj do .env a dopln vlastni tokeny. .env nikdy necommituj.
# Copy to .env and fill in your tokens. Never commit .env.

# Hugging Face – potreba pro gated modely (LTX-2.5) + rychlejsi stahovani.
# Vytvor na https://huggingface.co/settings/tokens (staci read).
# Na https://huggingface.co/Lightricks/LTX-2.5 klikni "Agree and Access".
HF_TOKEN=

# GitHub – potreba pro zalozeni / push repa pres gh CLI.
# Vytvor na https://github.com/settings/tokens (scopes: repo).
GITHUB_TOKEN=
